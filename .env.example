# ==============================================================================
# AI Resume Intelligence Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your local or production environment.
# DO NOT commit .env with real secrets to version control.
# ==============================================================================

# --- Application Core ---
APP_NAME="AI Resume Intelligence Platform"
APP_ENV="local"                # "local" | "staging" | "production"
DEBUG=true
LOG_LEVEL="INFO"              # "DEBUG" | "INFO" | "WARNING" | "ERROR"
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Security & JWT Authentication ---
# Generate a strong 64-character secret using: openssl rand -hex 32
SECRET_KEY="replace-with-a-secure-random-secret-key-for-local-dev-only"
JWT_SECRET_KEY="replace-with-a-secure-jwt-secret-key-for-local-dev-only"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS configuration (comma-separated list)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# --- Database & Vector Storage (PostgreSQL + pgvector / Supabase) ---
# For local Docker: postgresql+asyncpg://postgres:postgres@localhost:5432/resume_intelligence
# For Supabase: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/resume_intelligence"
DATABASE_URL_SYNC="postgresql://postgres:postgres@localhost:5432/resume_intelligence"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis (Cache & Rate Limiting) ---
REDIS_URL="redis://localhost:6379/0"

# --- AI Gateway Configuration (Dual-Mode: Local Ollama vs Deployed Azure OpenAI) ---
# Options: "ollama" (Free / Local) | "azure_openai" (Deployed / Capped Spend)
LLM_PROVIDER="ollama"

# Mode 1: Ollama Settings (Local Development — Free)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"

# Mode 2: Azure OpenAI Settings (Deployed Mode — Capped Budget)
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_DEPLOYMENT_NAME="gpt-4o-mini"
AZURE_OPENAI_API_VERSION="2024-08-01-preview"

# AI Gateway Resiliency & Circuit Breaker
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_CIRCUIT_BREAKER_FAILURES=3
AI_CIRCUIT_BREAKER_RESET_SECONDS=60

# --- Embeddings & Semantic Search ---
# Local sentence-transformers model (384 dimensions)
EMBEDDING_MODEL="all-MiniLM-L6-v2"
VECTOR_DIMENSION=384

# --- Storage & File Upload Controls ---
MAX_UPLOAD_SIZE_BYTES=10485760   # 10 MB in bytes
ALLOWED_MIME_TYPES="application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
ALLOWED_EXTENSIONS=".pdf,.docx"
UPLOAD_TEMP_DIR="./temp/uploads"

# --- Rate Limiting Thresholds ---
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_GLOBAL_PER_MINUTE=120

# --- Frontend Environment Variables (exposed to client) ---
NEXT_PUBLIC_APP_NAME="AI Resume Intelligence Platform"
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
